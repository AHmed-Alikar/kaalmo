PORT=5000
NODE_ENV=development

# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaalmo?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CLIENT_ORIGIN=http://localhost:5173

# Optional — leave unset to fall back to dev-mode console-logged emails.
# Get an API key at https://resend.com. Without a verified sending domain,
# Resend's test mode only delivers to the email address on your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Kaalmo <onboarding@resend.dev>

# EVC Plus (Hormuud) mobile money via the WaafiPay gateway. Leave unset to
# disable the 'evc_plus' donation provider (the 'manual' provider still works).
WAAFIPAY_BASE_URL=
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=

# Firebase Cloud Messaging (push notifications for the mobile app). Leave unset
# to disable push — in-app notifications keep working regardless. Values come
# from a Firebase service-account JSON key. FIREBASE_PRIVATE_KEY may be the raw
# multi-line key or a single line with \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
